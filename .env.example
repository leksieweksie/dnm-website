# Opn Payments (formerly Omise) — get from dashboard.opn.ooo > Settings > Keys
OPN_SECRET_KEY=skey_test_...
OPN_PUBLIC_KEY=pkey_test_...
OPN_WEBHOOK_SECRET=...   # set in Opn dashboard > Webhooks, auto-generated

# Supabase — get from your project > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NOT anon key)

# Resend — get from resend.com > API Keys
RESEND_API_KEY=re_...

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your site URL (used for CORS and redirect URIs)
SITE_URL=https://dnm-website-nine.vercel.app

# PromptPay — your Thai phone number or tax ID (fill in before going live)
PROMPTPAY_ID=+66947362815
